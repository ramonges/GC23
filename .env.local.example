# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase credentials
# You can find these in your Supabase project settings > API

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For running scripts that need service role access
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Mapbox Configuration (for satellite imagery)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# AIS Stream Configuration (for real-time vessel tracking)
# Sign up at https://aisstream.io and get your API key at https://aisstream.io/apikeys
AIS_STREAM_API_KEY=your_ais_stream_api_key_here
